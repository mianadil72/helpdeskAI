# Used only by Playwright (playwright.config.ts); copy to .env.test. Points at a
# separate database whose data is wiped at the start of every test run, so the
# database name must end in _test.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk_test?schema=public"

# Generate with `openssl rand -base64 32` (at least 32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# The Vite server Playwright starts for tests
TRUSTED_ORIGINS=http://localhost:5174

# Admin seeded into the test database before each run
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=
ADMIN_NAME=Test Admin
