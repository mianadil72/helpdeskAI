{
  "name": "@helpdesk/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && node --watch --import tsx --env-file-if-exists=.env src/index.ts",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@helpdesk/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "express": "^5.2.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
