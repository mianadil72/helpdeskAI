PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/helpdesk?schema=public"
# Set to production when deploying
NODE_ENV=development
# Proxy hops to trust for the client IP (used by sign-in rate limiting), e.g. 1
# behind a single reverse proxy. Leave empty when clients connect directly.
TRUST_PROXY=

# Better Auth: generate a secret with `openssl rand -base64 32`. Required, at
# least 32 characters; the server refuses to start without it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call /api/auth (the Vite dev server)
TRUSTED_ORIGINS=http://localhost:5173

# Initial admin, created by `npm run db:seed -w server`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Shared secret for POST /api/inbound/email (support emails → tickets), sent as
# `Authorization: Bearer <secret>`. Generate with `openssl rand -base64 32`.
# Leave empty to disable the endpoint (it responds 503).
INBOUND_EMAIL_SECRET=

# OpenAI API key for AI features (the "Polish" button on replies, gpt-5-nano
# via the Vercel AI SDK). Optional: leave empty and those features respond 503
# while the manual workflow keeps working.
OPENAI_API_KEY=
